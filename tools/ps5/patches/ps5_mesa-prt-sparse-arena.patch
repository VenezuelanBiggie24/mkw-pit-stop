  * (PS5_Vulkan R86-R88). */
 #define RADV_PS5_REGION_BASE UINT64_C(0x4000000000)
 #define RADV_PS5_REGION_BYTES (UINT64_C(256) << 30)
+/* Dedicated 128 GiB PRT aperture above the 256 GiB direct-memory region so
+ * unbound sparse tiles read zero without backing a shared zero block. */
+#define RADV_PS5_PRT_ARENA_BASE UINT64_C(0x8000000000)
+#define RADV_PS5_PRT_ARENA_BYTES (UINT64_C(128) << 30)
+
+int sceKernelGetPageTableStats(int *cpu_total, int *cpu_free, int *gpu_total, int *gpu_free);
+int32_t sceKernelSetPrtAperture(int id, void *address, size_t size);
 
 static struct radv_ps5_granules radv_ps5_region;
+static struct radv_ps5_granules radv_ps5_prt_arena;
+static simple_mtx_t radv_ps5_prt_lock = SIMPLE_MTX_INITIALIZER;
+static bool radv_ps5_prt_ready;
+static bool radv_ps5_prt_init_done;
+static bool radv_ps5_prt_fallback_logged;
 static once_flag radv_ps5_once = ONCE_FLAG_INIT;
 static bool radv_ps5_ready;
 
+static inline bool
+radv_ps5_vrange_is_prt(const void *at)
+{
+   const uintptr_t va = (uintptr_t)at;
+   return va >= RADV_PS5_PRT_ARENA_BASE && va < RADV_PS5_PRT_ARENA_BASE + RADV_PS5_PRT_ARENA_BYTES;
+}
+
+static void
+radv_ps5_prt_log_fallback_once(const char *reason)
+{
+   simple_mtx_lock(&radv_ps5_prt_lock);
+   if (!radv_ps5_prt_fallback_logged) {
+      radv_ps5_prt_fallback_logged = true;
+      fprintf(stderr, "radv/ps5: sparse fallback to zero block (%s)\n", reason);
+   }
+   simple_mtx_unlock(&radv_ps5_prt_lock);
+}
+
+static bool
+radv_ps5_prt_arena_init(void)
+{
+   simple_mtx_lock(&radv_ps5_prt_lock);
+   if (radv_ps5_prt_init_done) {
+      const bool ready = radv_ps5_prt_ready;
+      simple_mtx_unlock(&radv_ps5_prt_lock);
+      return ready;
+   }
+   radv_ps5_prt_init_done = true;
+
+   int cpu_tot = 0, cpu_free_before = 0, gpu_tot = 0, gpu_free_before = 0;
+   int cpu_free_after = 0, gpu_free_after = 0;
+   const int pt_before_rc = sceKernelGetPageTableStats(&cpu_tot, &cpu_free_before, &gpu_tot, &gpu_free_before);
+
+   void *arena = (void *)(uintptr_t)RADV_PS5_PRT_ARENA_BASE;
+   const int32_t res_rc = sceKernelReserveVirtualRange(&arena, RADV_PS5_PRT_ARENA_BYTES, 0, RADV_PS5_LARGE_BYTES);
+   int32_t ap_rc = -1;
+   if (res_rc == 0 && (uintptr_t)arena == RADV_PS5_PRT_ARENA_BASE &&
+       ((uintptr_t)arena % RADV_PS5_PRT_ARENA_BYTES) == 0) {
+      ap_rc = sceKernelSetPrtAperture(0, arena, RADV_PS5_PRT_ARENA_BYTES);
+      if (ap_rc == 0) {
+         radv_ps5_prt_ready = radv_ps5_granules_init(&radv_ps5_prt_arena, RADV_PS5_PRT_ARENA_BASE,
+                                                     RADV_PS5_PRT_ARENA_BYTES, RADV_PS5_LARGE_BYTES);
+      } else {
+         sceKernelMunmap(arena, RADV_PS5_PRT_ARENA_BYTES);
+      }
+   } else if (res_rc == 0 && arena != NULL) {
+      sceKernelMunmap(arena, RADV_PS5_PRT_ARENA_BYTES);
+   }
+
+   const int pt_after_rc = sceKernelGetPageTableStats(&cpu_tot, &cpu_free_after, &gpu_tot, &gpu_free_after);
+   const int cpu_before = pt_before_rc == 0 ? (cpu_tot - cpu_free_before) : -1;
+   const int cpu_after = pt_after_rc == 0 ? (cpu_tot - cpu_free_after) : -1;
+   const int gpu_before = pt_before_rc == 0 ? (gpu_tot - gpu_free_before) : -1;
+   const int gpu_after = pt_after_rc == 0 ? (gpu_tot - gpu_free_after) : -1;
+   fprintf(stderr,
+           "radv/ps5: prt arena va=%p size=%" PRIu64 " reserve_rc=0x%08x aperture_rc=0x%08x "
+           "cpu_used=%d->%d gpu_used=%d->%d\n",
+           arena, (uint64_t)RADV_PS5_PRT_ARENA_BYTES, (unsigned)res_rc, (unsigned)ap_rc,
+           cpu_before, cpu_after, gpu_before, gpu_after);
+
+   const bool ready = radv_ps5_prt_ready;
+   simple_mtx_unlock(&radv_ps5_prt_lock);
+   return ready;
+}
